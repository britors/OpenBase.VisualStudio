<?xml version="1.0" encoding="utf-8"?>
<Vsix xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" Version="1.0.0">
  <Identifier Id="OpenBase.VisualStudio.1234">
    <Name>OpenBase</Name>
    <Author>OpenBase</Author>
    <Version>1.0</Version>
    <Description xml:space="preserve">OpenBase extension for Visual Studio - SQL, HTTP, Diagrams and more.</Description>
    <Locale>1033</Locale>
    <MoreInfoUrl>https://github.com/OpenBase/OpenBase</MoreInfoUrl>
    <Icon>Resources\Icon.png</Icon>
    <PreviewImage>Resources\Preview.png</PreviewImage>
    <Tags>sql, http, rest, database, migration</Tags>
    <GettingStartedGuide>https://github.com/OpenBase/OpenBase</GettingStartedGuide>
  </Identifier>
  <Content>
    <VsPackage>
      <AssetType>Microsoft.VisualStudio.VsPackage</AssetType>
      <Path>OpenBase.VisualStudio.dll</Path>
    </VsPackage>
  </Content>
  <Dependencies>
    <Dependency Id="Microsoft.Framework.NDP" DisplayName="Microsoft .NET Framework" Version="[4.5,)" />
  </Dependencies>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.0,18.0)" DisplayName="Visual Studio core editor" />
  </Prerequisites>
</Vsix>
