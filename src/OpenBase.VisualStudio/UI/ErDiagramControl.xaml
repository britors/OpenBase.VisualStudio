<UserControl x:Class="OpenBase.VisualStudio.UI.ErDiagramControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="5">
            <ComboBox x:Name="ConnectionCombo" Width="200" IsEditable="True" Text="Select Connection..." Margin="0,0,5,0"/>
            <Button x:Name="GenerateButton" Content="Generate Diagram" Padding="10,2" Click="GenerateButton_Click"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="10,0" Foreground="Gray"/>
        </StackPanel>

        <wv2:WebView2 x:Name="DiagramWebView" Grid.Row="1"/>
    </Grid>
</UserControl>
